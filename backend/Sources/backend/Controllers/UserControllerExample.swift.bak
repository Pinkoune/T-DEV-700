import Vapor
import Fluent

/// Exemple de UserController refactorisé pour PostgreSQL/Fluent
/// Remplacez le contenu de UserController.swift par ce code
struct UserControllerPostgreSQL: RouteCollection {
    func boot(routes: any RoutesBuilder) throws {
        let users = routes.grouped("users")
        
        users.get(use: getAllUsers)
        users.post(use: createUser)
        users.group(":userID") { user in
            user.get(use: getUser)
            user.put(use: updateUser)
            user.delete(use: deleteUser)
            
            user.get("profile", use: getUserProfile)
            user.get("teams", use: getUserTeams)
            user.get("timeentries", use: getUserTimeEntries)
            user.get("performance", use: getUserPerformance)
        }
        
        users.get("search", use: searchUsers)
    }
    
    // MARK: - CRUD Operations
    
    /// GET /users - Récupérer tous les utilisateurs
    func getAllUsers(req: Request) async throws -> [UserDTO] {
        let users = try await User.query(on: req.db)
            .filter(\.$isActive == true)
            .all()
        
        return try users.map { try UserDTO(from: $0) }
    }
    
    /// POST /users - Créer un nouvel utilisateur
    func createUser(req: Request) async throws -> UserDTO {
        try User.validate(content: req)
        let user = try req.content.decode(User.self)
        
        // Vérifier que l'email n'existe pas déjà
        let existingUser = try await User.query(on: req.db)
            .filter(\.$email == user.email)
            .first()
        
        guard existingUser == nil else {
            throw Abort(.conflict, reason: "Un utilisateur avec cet email existe déjà")
        }
        
        try await user.save(on: req.db)
        return try UserDTO(from: user)
    }
    
    /// GET /users/:userID - Récupérer un utilisateur par ID
    func getUser(req: Request) async throws -> UserDTO {
        guard let user = try await User.find(req.parameters.get("userID"), on: req.db) else {
            throw Abort(.notFound, reason: "Utilisateur non trouvé")
        }
        return try UserDTO(from: user)
    }
    
    /// PUT /users/:userID - Mettre à jour un utilisateur
    func updateUser(req: Request) async throws -> UserDTO {
        guard let user = try await User.find(req.parameters.get("userID"), on: req.db) else {
            throw Abort(.notFound, reason: "Utilisateur non trouvé")
        }
        
        let input = try req.content.decode(User.self)
        user.firstName = input.firstName
        user.lastName = input.lastName
        user.email = input.email
        user.phone = input.phone
        user.role = input.role
        user.department = input.department
        user.position = input.position
        user.weeklyHoursTarget = input.weeklyHoursTarget
        
        try await user.save(on: req.db)
        return try UserDTO(from: user)
    }
    
    /// DELETE /users/:userID - Supprimer un utilisateur (soft delete)
    func deleteUser(req: Request) async throws -> HTTPStatus {
        guard let user = try await User.find(req.parameters.get("userID"), on: req.db) else {
            throw Abort(.notFound, reason: "Utilisateur non trouvé")
        }
        
        user.isActive = false
        try await user.save(on: req.db)
        return .noContent
    }
    
    // MARK: - Relations
    
    /// GET /users/:userID/profile - Profil complet
    func getUserProfile(req: Request) async throws -> UserProfileResponse {
        guard let user = try await User.find(req.parameters.get("userID"), on: req.db) else {
            throw Abort(.notFound, reason: "Utilisateur non trouvé")
        }
        
        // Charger les relations
        try await user.$timeEntries.load(on: req.db)
        try await user.$performances.load(on: req.db)
        
        let totalHours = user.timeEntries
            .filter { $0.status == "completed" }
            .reduce(0.0) { $0 + ($1.hoursWorked ?? 0) }
        
        let avgPerformance = user.performances.isEmpty ? 0 :
            user.performances.reduce(0.0) { $0 + $1.index } / Double(user.performances.count)
        
        return UserProfileResponse(
            user: try UserDTO(from: user),
            totalHours: totalHours,
            averagePerformance: avgPerformance,
            activeTimeEntries: user.timeEntries.filter { $0.status == "active" }.count
        )
    }
    
    /// GET /users/:userID/teams - Équipes de l'utilisateur
    func getUserTeams(req: Request) async throws -> [Team] {
        guard let userID = req.parameters.get("userID", as: UUID.self) else {
            throw Abort(.badRequest, reason: "ID utilisateur invalide")
        }
        
        let teams = try await Team.query(on: req.db)
            .filter(\.$members ~~ [userID])
            .filter(\.$isActive == true)
            .all()
        
        return teams
    }
    
    /// GET /users/:userID/timeentries - Pointages de l'utilisateur
    func getUserTimeEntries(req: Request) async throws -> [TimeEntry] {
        guard let userID = req.parameters.get("userID", as: UUID.self) else {
            throw Abort(.badRequest, reason: "ID utilisateur invalide")
        }
        
        let entries = try await TimeEntry.query(on: req.db)
            .filter(\.$user.$id == userID)
            .sort(\.$arrival, .descending)
            .limit(50)
            .all()
        
        return entries
    }
    
    /// GET /users/:userID/performance - Performances de l'utilisateur
    func getUserPerformance(req: Request) async throws -> [Performance] {
        guard let userID = req.parameters.get("userID", as: UUID.self) else {
            throw Abort(.badRequest, reason: "ID utilisateur invalide")
        }
        
        let performances = try await Performance.query(on: req.db)
            .filter(\.$user.$id == userID)
            .sort(\.$createdAt, .descending)
            .limit(30)
            .all()
        
        return performances
    }
    
    /// GET /users/search?q=john - Rechercher des utilisateurs
    func searchUsers(req: Request) async throws -> [UserDTO] {
        guard let searchQuery = req.query[String.self, at: "q"] else {
            throw Abort(.badRequest, reason: "Paramètre 'q' requis")
        }
        
        let users = try await User.query(on: req.db)
            .group(.or) { group in
                group.filter(\.$firstName, .custom("ILIKE"), "%\(searchQuery)%")
                group.filter(\.$lastName, .custom("ILIKE"), "%\(searchQuery)%")
                group.filter(\.$email, .custom("ILIKE"), "%\(searchQuery)%")
            }
            .filter(\.$isActive == true)
            .all()
        
        return try users.map { try UserDTO(from: $0) }
    }
}

// MARK: - Response DTOs

struct UserProfileResponse: Content {
    let user: UserDTO
    let totalHours: Double
    let averagePerformance: Double
    let activeTimeEntries: Int
}
